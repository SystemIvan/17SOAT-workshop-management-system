provider "aws" {
  region = var.region

  # Every resource carries these tags, which makes leftovers easy to find in the console after a destroy.
  default_tags {
    tags = {
      Project   = "workshop-management-system"
      Stack     = "aws-database"
      ManagedBy = "terraform"
    }
  }
}

# Network and cluster facts come from the cluster stack state instead of being copied by hand, which also fixes
# the order: this stack cannot be planned before the cluster stack has been applied.
data "terraform_remote_state" "cluster" {
  backend = "s3"
  config = {
    bucket = var.state_bucket
    key    = "aws/cluster.tfstate"
    region = var.region
  }
}

locals {
  cluster = data.terraform_remote_state.cluster.outputs
}

# Short-lived token generated by the AWS CLI on every run, so no cluster credential is stored in the state.
# Requires the aws CLI on the machine that runs Terraform (PC or GitHub runner).
provider "kubernetes" {
  host                   = local.cluster.cluster_endpoint
  cluster_ca_certificate = base64decode(local.cluster.cluster_ca_certificate)
  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "aws"
    args        = ["eks", "get-token", "--cluster-name", local.cluster.cluster_name, "--region", var.region]
  }
}

### RDS ###

resource "aws_security_group" "rds" {
  name        = "workshop-rds"
  description = "MySQL reachable only from the EKS worker nodes"
  vpc_id      = local.cluster.vpc_id
}

# The only way in: port 3306 from the security group EKS attaches to the nodes. No CIDR rule, so neither the
# internet nor other resources in the VPC can connect. RDS needs no egress rule (it never opens connections).
resource "aws_vpc_security_group_ingress_rule" "mysql_from_nodes" {
  security_group_id            = aws_security_group.rds.id
  referenced_security_group_id = local.cluster.cluster_security_group_id
  ip_protocol                  = "tcp"
  from_port                    = 3306
  to_port                      = 3306
  description                  = "MySQL from EKS nodes"
}

resource "aws_db_subnet_group" "this" {
  name       = "workshop-db"
  subnet_ids = local.cluster.private_subnet_ids
}

# Special characters are disabled: RDS rejects some of them (/, @, ", space) and the value travels through
# shell environments in the pipeline.
resource "random_password" "app" {
  length  = 24
  special = false
}

# The application connects as the RDS master user. Creating a separate least-privilege user would require a
# MySQL connection from Terraform into the private subnets, which this disposable lab does not have; accepted
# and recorded in the security review (CP8).
resource "aws_db_instance" "this" {
  identifier     = "workshop-mysql"
  engine         = "mysql"
  engine_version = var.mysql_engine_version
  instance_class = var.instance_class

  allocated_storage = var.allocated_storage
  storage_type      = "gp3"
  storage_encrypted = true

  db_name  = var.database_name
  username = var.database_username
  password = random_password.app.result

  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.rds.id]
  publicly_accessible    = false
  multi_az               = false

  # Disposable lab: no automated backups (faster create, no backup storage), no final snapshot and no
  # deletion protection, so terraform destroy removes everything that charges credit.
  backup_retention_period = 0
  skip_final_snapshot     = true
  deletion_protection     = false
  apply_immediately       = true

  timeouts {
    create = "40m"
    delete = "40m"
  }
}

### Connection contract in the cluster (technical-spec D1, same names as infra/local/database) ###

locals {
  # sslMode=REQUIRED encrypts the connection to RDS (unlike the local useSSL=false); the server certificate is
  # not verified, which is acceptable inside the private VPC. Over TLS the password exchange is already
  # protected, so allowPublicKeyRetrieval is no longer needed.
  db_url = join("", [
    "jdbc:mysql://${aws_db_instance.this.address}:${aws_db_instance.this.port}/${var.database_name}",
    "?sslMode=REQUIRED&serverTimezone=America/Sao_Paulo",
  ])
}

resource "kubernetes_namespace_v1" "workshop" {
  metadata {
    name = var.namespace
  }
}

resource "kubernetes_config_map_v1" "workshop_db" {
  metadata {
    name      = "workshop-db"
    namespace = kubernetes_namespace_v1.workshop.metadata[0].name
  }
  data = {
    DB_URL = local.db_url
  }
}

resource "kubernetes_secret_v1" "workshop_db" {
  metadata {
    name      = "workshop-db"
    namespace = kubernetes_namespace_v1.workshop.metadata[0].name
  }
  data = {
    DB_USERNAME = var.database_username
    DB_PASSWORD = random_password.app.result
  }
}
