# .env.example - Copie para .env e preencha com seus valores

# Database Configuration
DB_ROOT_PASSWORD=root
DB_NAME=workshop
DB_USERNAME=workshop_user
DB_PASSWORD=workshop_pass
DB_PORT=3306

# Application Configuration
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_SEED_ENABLED=true
# O schema é sempre validado (ddl-auto=validate, fixo no application.properties); o Flyway aplica as migrations.
# A memória da JVM vem da imagem (JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0), proporcional ao limite do container.

# Fornecedor externo (simulado pelo WireMock no compose) - o simulador local não exige chave, então pode ficar vazia
SUPPLIER_API_KEY=

# Security (JWT) - troque este valor em qualquer ambiente real; o padrão do código é só para dev local
APP_SECURITY_JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-bytes

# Security (HMAC do gateway externo de aprovação de orçamento, RF41) - troque em qualquer ambiente real e
# compartilhe o mesmo valor com o gateway; o padrão coincide com a variável estimateGatewaySecret da coleção Postman
APP_SECURITY_ESTIMATE_GATEWAY_HMAC_SECRET=local-development-only-estimate-gateway-secret-please-rotate
