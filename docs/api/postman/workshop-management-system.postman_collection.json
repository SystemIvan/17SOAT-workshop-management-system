        {
          "name": "Service Orders",
          "item": [
            {
              "name": "Create service order",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) { pm.collectionVariables.set('serviceOrderId', pm.response.json().id); }"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"vehicleSnapshot\": {\n    \"licensePlate\": \"ABC1D23\",\n    \"brand\": \"Fiat\",\n    \"model\": \"Argo\",\n    \"year\": 2024\n  },\n  \"priority\": \"NORMAL\",\n  \"initialAssessment\": \"Ruído ao frear relatado pelo cliente\"\n}"
                },
                "url": "{{baseUrl}}/api/service-orders"
              }
            },
            {
              "name": "List service orders",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/service-orders",
                "description": "Sem parâmetros retorna todas as ordens de serviço. status, customerId, technicianId e priority são filtros opcionais e combináveis com AND; technicianId casa com o diagnosisAssigneeId da SO ou com o assignedTechnicianId de qualquer execução."
              }
            },
            {
              "name": "List service orders filtered by status",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/service-orders?status=IN_DIAGNOSIS"
              }
            },
            {
              "name": "List service orders filtered by customer",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/service-orders?customerId={{customerId}}"
              }
            },
            {
              "name": "List service orders filtered by technician",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/service-orders?technicianId={{technicianId}}"
              }
            },
            {
              "name": "List service orders filtered by priority",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/service-orders?priority=HIGH"
              }
            },
            {
              "name": "Get service order",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}"
              }
            },
            {
              "name": "Get service order status",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/status"
              }
            },
            {
              "name": "Assign diagnosis assignee",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"technicianId\": \"{{technicianId}}\"\n}"
                },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/diagnosis-assignee"
              }
            },
            {
              "name": "Perform diagnosis",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200 && pm.response.json().executions.length > 0) { const execution = pm.response.json().executions[0]; pm.collectionVariables.set('executionId', execution.id); pm.collectionVariables.set('serviceExecutionId', execution.id); pm.collectionVariables.set('diagnosisId', execution.diagnosisId); }"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"diagnosedByTechnicianId\": \"{{technicianId}}\",\n  \"items\": [{\n    \"catalogServiceId\": \"{{catalogServiceId}}\",\n    \"name\": \"Oil and filter change\",\n    \"price\": { \"value\": 150.00, \"currency\": \"BRL\" },\n    \"stockRequirements\": [{\n      \"stockItemId\": \"{{stockItemId}}\",\n      \"type\": \"PART\",\n      \"quantity\": 1,\n      \"nameSnapshot\": \"Oil filter\",\n      \"priceSnapshot\": { \"value\": 45.90, \"currency\": \"BRL\" }\n    }]\n  }]\n}" },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/diagnosis",
                "description": "Cada catalogServiceId deve identificar um serviço ativo no início do diagnóstico. Serviços arquivados ou inexistentes rejeitam todo o lote sem persistência parcial; execuções já criadas preservam seus snapshots."
              }
            },
            {
              "name": "Change service order priority",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"priority\": \"HIGH\"\n}"
                },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/priority"
              }
            },
            {
              "name": "Assign technician",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"technicianId\": \"{{technicianId}}\"\n}"
                },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/executions/{{executionId}}/assign-technician"
              }
            },
            {
              "name": "Attach stock requirement",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"stockItemId\": \"{{stockItemId}}\",\n  \"type\": \"PART\",\n  \"quantity\": 1,\n  \"nameSnapshot\": \"Oil filter\",\n  \"priceSnapshot\": { \"value\": 45.90, \"currency\": \"BRL\" }\n}"
                },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/executions/{{executionId}}/stock-requirements"
              }
            },
            {
              "name": "Retry stock reservation",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200 && pm.response.json().reservationId) { pm.collectionVariables.set('stockReservationId', pm.response.json().reservationId); }"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/executions/{{serviceExecutionId}}/stock-reservation",
                "description": "Repete a tentativa sobre os requirements congelados. Não aceita linhas no corpo da requisição."
              },
              "response": [
                {
                  "name": "Reserved",
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [],
                  "cookie": [],
                  "body": "{\n  \"serviceExecutionId\": \"66666666-6666-6666-6666-666666666666\",\n  \"outcome\": \"RESERVED\",\n  \"reservationId\": \"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\",\n  \"issues\": []\n}"
                },
                {
                  "name": "Not reserved",
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [],
                  "cookie": [],
                  "body": "{\n  \"serviceExecutionId\": \"66666666-6666-6666-6666-666666666666\",\n  \"outcome\": \"NOT_RESERVED\",\n  \"reservationId\": null,\n  \"issues\": [{\n    \"stockItemId\": \"44444444-4444-4444-4444-444444444444\",\n    \"reason\": \"INSUFFICIENT_QUANTITY\",\n    \"requestedQuantity\": 2,\n    \"availableQuantity\": 1\n  }]\n}"
                }
              ]
            },
            {
              "name": "Start execution",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/executions/{{executionId}}/start"
              }
            },
            {
              "name": "Update execution progress",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"note\": \"Oil drained and filter replaced\"\n}"
                },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/executions/{{executionId}}/progress"
              }
            },
            {
              "name": "Complete execution",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/executions/{{executionId}}/complete"
              }
            },
            {
              "name": "Finalize service order",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"vehicleDelivered\": true\n}"
                },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/finalize"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Estimates",
      "item": [
        {
          "name": "Generate estimate",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const diagnosisId = pm.collectionVariables.get('diagnosisId'); if (!diagnosisId) { throw new Error('Run Perform diagnosis successfully before generating an estimate.'); } pm.variables.set('diagnosisId', diagnosisId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('estimateId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diagnosisId\": \"{{diagnosisId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/estimates"
          }
        },
        {
          "name": "Get estimate",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/estimates/{{estimateId}}"
          }
        },
        {
          "name": "Decide estimate lines",
          "request": {
            "method": "POST",
            "header": [
