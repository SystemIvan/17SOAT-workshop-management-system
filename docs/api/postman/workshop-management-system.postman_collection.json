{
  "info": {
    "_postman_id": "c0d4f6e8-0f31-4d2f-9ba8-17f0b5fe2026",
    "name": "Workshop Management System",
    "description": "Coleção da API REST agrupada por contexto delimitado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "customerId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "customerTaxId", "value": "52998224725" },
    { "key": "vehicleId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "technicianId", "value": "33333333-3333-3333-3333-333333333333" },
    { "key": "stockItemId", "value": "44444444-4444-4444-4444-444444444444" },
    { "key": "serviceOrderId", "value": "55555555-5555-5555-5555-555555555555" },
    { "key": "executionId", "value": "66666666-6666-6666-6666-666666666666" },
    { "key": "catalogServiceId", "value": "77777777-7777-7777-7777-777777777777" }
  ],
  "item": [
    {
      "name": "Cadastros (Registrations)",
      "item": [
        {
          "name": "Cadastrar cliente",
          "event": [{
            "listen": "test",
            "script": { "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('customerId', pm.response.json().id); }"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Maria Silva\",\n  \"document\": \"529.982.247-25\",\n  \"contactInfo\": {\n    \"email\": \"maria@example.test\",\n    \"phone\": \"+5511999999999\"\n  }\n}" },
            "url": "{{baseUrl}}/api/customers"
          }
        },
        { "name": "Consultar cliente", "request": { "method": "GET", "url": "{{baseUrl}}/api/customers/{{customerId}}" } },
        { "name": "Identificar cliente por CPF/CNPJ", "request": { "method": "GET", "url": "{{baseUrl}}/api/customers/identify?document={{customerTaxId}}" } },
        { "name": "Listar clientes", "request": { "method": "GET", "url": "{{baseUrl}}/api/customers" } },
        {
          "name": "Alterar nome do cliente",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Maria Souza\"\n}" },
            "url": "{{baseUrl}}/api/customers/{{customerId}}"
          }
        },
        {
          "name": "Atualizar e-mail do cliente",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"contactInfo\": {\n    \"email\": \"maria.souza@example.test\"\n  }\n}" },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/contact-info"
          }
        },
        {
          "name": "Adicionar ou substituir endereço do cliente",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"contactInfo\": {\n    \"address\": {\n      \"street\": \"Avenida Paulista\",\n      \"number\": \"1000\",\n      \"complement\": \"Conjunto 101\",\n      \"neighborhood\": \"Bela Vista\",\n      \"city\": \"São Paulo\",\n      \"state\": \"SP\",\n      \"postalCode\": \"01310-100\"\n    }\n  }\n}" },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/contact-info"
          }
        },
        {
          "name": "Arquivar cliente",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/customers/{{customerId}}"
          }
        }
      ]
    },
    {
      "name": "Service Lifecycle",
      "item": [
        {
          "name": "Technicians",
          "item": [
            {
              "name": "Create technician",
              "event": [{
                "listen": "test",
                "script": { "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('technicianId', pm.response.json().id); }"] }
              }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Joao Technician\",\n  \"specialties\": [\"MECHANICAL\", \"DIAGNOSTICS\"]\n}" },
                "url": "{{baseUrl}}/api/technicians"
              }
            },
            { "name": "Get technician", "request": { "method": "GET", "url": "{{baseUrl}}/api/technicians/{{technicianId}}" } },
            { "name": "List technicians", "request": { "method": "GET", "url": "{{baseUrl}}/api/technicians" } },
            {
              "name": "Rename technician",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Joao Senior Technician\"\n}" },
                "url": "{{baseUrl}}/api/technicians/{{technicianId}}"
              }
            },
            {
              "name": "Update technician status",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"status\": \"BUSY\"\n}" },
                "url": "{{baseUrl}}/api/technicians/{{technicianId}}/status"
              }
            }
          ]
        },
        {
          "name": "Service Orders",
          "item": [
            {
              "name": "Create service order",
              "event": [{
                "listen": "test",
                "script": { "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('serviceOrderId', pm.response.json().id); }"] }
              }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"vehicleSnapshot\": {\n    \"licensePlate\": \"ABC1D23\",\n    \"brand\": \"Fiat\",\n    \"model\": \"Argo\",\n    \"year\": 2024\n  },\n  \"priority\": \"NORMAL\"\n}" },
                "url": "{{baseUrl}}/api/service-orders"
              }
            },
            { "name": "Get service order", "request": { "method": "GET", "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}" } },
            { "name": "Get service order status", "request": { "method": "GET", "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/status" } },
            {
              "name": "Perform diagnosis",
              "event": [{
                "listen": "test",
                "script": { "exec": ["if (pm.response.code === 200 && pm.response.json().executions.length > 0) { pm.collectionVariables.set('executionId', pm.response.json().executions[0].id); }"] }
              }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"items\": [{\n    \"catalogServiceId\": \"{{catalogServiceId}}\",\n    \"name\": \"Oil and filter change\",\n    \"price\": { \"value\": 150.00, \"currency\": \"BRL\" },\n    \"stockRequirements\": [{\n      \"stockItemId\": \"{{stockItemId}}\",\n      \"type\": \"PART\",\n      \"quantity\": 1,\n      \"nameSnapshot\": \"Oil filter\",\n      \"priceSnapshot\": { \"value\": 45.90, \"currency\": \"BRL\" }\n    }]\n  }]\n}" },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/diagnosis"
              }
            },
            {
              "name": "Assign technician",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"technicianId\": \"{{technicianId}}\"\n}" },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/executions/{{executionId}}/assign-technician"
              }
            },
            { "name": "Start execution", "request": { "method": "POST", "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/executions/{{executionId}}/start" } },
            {
              "name": "Update execution progress",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"note\": \"Oil drained and filter replaced\"\n}" },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/executions/{{executionId}}/progress"
              }
            },
            { "name": "Complete execution", "request": { "method": "POST", "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/executions/{{executionId}}/complete" } },
            {
              "name": "Finalize service order",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"vehicleDelivered\": true\n}" },
                "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}/finalize"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Stock & Procurement",
      "item": [
        {
          "name": "Create stock item",
          "event": [{
            "listen": "test",
            "script": { "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('stockItemId', pm.response.json().id); }"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Oil filter\",\n  \"sku\": \"FILTER-001\",\n  \"type\": \"PART\",\n  \"availableQuantity\": 20,\n  \"price\": { \"value\": 45.90, \"currency\": \"BRL\" }\n}" },
            "url": "{{baseUrl}}/api/stock-items"
          }
        },
        { "name": "Get stock item", "request": { "method": "GET", "url": "{{baseUrl}}/api/stock-items/{{stockItemId}}" } },
        { "name": "Search available parts and supplies", "request": { "method": "GET", "url": "{{baseUrl}}/api/stock-items?search=filter&type=PART&type=SUPPLY&available=true&active=true" } },
        {
          "name": "Update stock item",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Premium oil filter\",\n  \"price\": { \"value\": 49.90, \"currency\": \"BRL\" }\n}" },
            "url": "{{baseUrl}}/api/stock-items/{{stockItemId}}"
          }
        },
        {
          "name": "Deactivate stock item",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/stock-items/{{stockItemId}}"
          }
        }
      ]
    }
  ]
}
