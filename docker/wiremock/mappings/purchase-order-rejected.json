{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/purchase-orders",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.items[?(@.productCode == 'SUPPLIER-REJECT-001')]"
      }
    ]
  },
  "response": {
    "status": 422,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "PRODUCT_NOT_AVAILABLE",
      "message": "Purchase order cannot be accepted"
    }
  }
}
