# Non-sensitive configuration common to every environment (technical-spec D1). Overlays merge their own values.
# The database URL comes from the "workshop-db" ConfigMap created by Terraform, never from here.
SPRING_PROFILES_ACTIVE=default
APP_SEED_ENABLED=false
SUPPLIER_BASE_URL=http://supplier-simulator:8080
SUPPLIER_CONNECT_TIMEOUT=2s
SUPPLIER_READ_TIMEOUT=5s
APP_NOTIFICATION_EMAIL_CHANNEL=smtp
APP_NOTIFICATION_EMAIL_FROM=no-reply@workshop.local
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
TZ=America/Sao_Paulo
