# AWS values: never reuse the local development secrets here. Copy to secrets.env, which is git-ignored.
# Generate each secret with a cryptographic generator (Get-Random is predictable), in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
# cd-aws.yml writes this file from the secrets of the aws-academy environment.
# The supplier simulator does not check the key, so it may stay empty.
SUPPLIER_API_KEY=
APP_SECURITY_JWT_SECRET=
# Must match the estimateGatewaySecret variable of the Postman collection used against AWS.
APP_SECURITY_ESTIMATE_GATEWAY_HMAC_SECRET=
# Mailpit inside the cluster accepts unauthenticated SMTP.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
