# Development values for the local kind cluster: the same defaults as docker-compose.yml and .env.example, not real
# secrets. scripts/k8s/local-up.sh reads .env.local when it exists (ignored by Git) and falls back to this file.
MYSQL_ROOT_PASSWORD=root
DB_USERNAME=workshop_user
DB_PASSWORD=workshop_pass
APP_SECURITY_JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-bytes
APP_SECURITY_ESTIMATE_GATEWAY_HMAC_SECRET=local-development-only-estimate-gateway-secret-please-rotate
