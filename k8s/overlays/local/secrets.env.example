# LOCAL DEVELOPMENT VALUES ONLY (kind cluster on localhost). Copy to secrets.env, which is git-ignored.
# Never reuse these values on AWS or any shared environment.
# The local supplier simulator does not check the key, so it may stay empty.
SUPPLIER_API_KEY=
APP_SECURITY_JWT_SECRET=local-development-only-kind-jwt-secret-please-rotate
# Must match the estimateGatewaySecret variable of the Postman collection.
APP_SECURITY_ESTIMATE_GATEWAY_HMAC_SECRET=local-development-only-estimate-gateway-secret-please-rotate
# Mailpit accepts unauthenticated SMTP.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
